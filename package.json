{
  "name": "dsh-worktree",
  "version": "0.1.0",
  "private": true,
  "description": "Git branch & worktree picker for the DSH composer toolbar, sidebar session rows and session header. Exposes the built-in worktree capability in the UI and manages parallel task worktrees under ~/.dsh-worktree.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./contract": "./contract.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "client/",
    "contract.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "git",
    "worktree",
    "branch"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
